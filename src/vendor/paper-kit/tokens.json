{
  "$schema": "paper-kit tokens v1",
  "meta": {
    "name": "paper-kit",
    "version": "1.1.1",
    "date": "2026-11-22",
    "source": "Prism, Paper Cutout (Destroy the Duck restyle)"
  },
  "font": {
    "display": {
      "family": "'Fraunces', Georgia, serif",
      "google": "Fraunces:opsz,wght,SOFT@9..144,400..900,0..100",
      "axes": {
        "SOFT": 60,
        "WONK": 0
      }
    },
    "ui": {
      "family": "'Figtree', system-ui, sans-serif",
      "google": "Figtree:wght@400..800"
    },
    "mono": {
      "family": "'DM Mono', ui-monospace, Menlo, monospace",
      "google": "DM+Mono:wght@400;500"
    }
  },
  "type": {
    "display-l": {
      "font": "display",
      "size": 28,
      "line": 32,
      "weight": 700,
      "soft": 60,
      "opsz": 72,
      "tracking": "-0.01em"
    },
    "display-m": {
      "font": "display",
      "size": 22,
      "line": 26,
      "weight": 700,
      "soft": 60,
      "opsz": 48,
      "tracking": "-0.01em"
    },
    "display-s": {
      "font": "display",
      "size": 16,
      "line": 20,
      "weight": 700,
      "soft": 60,
      "opsz": 24
    },
    "action": {
      "font": "display",
      "size": 19,
      "line": 20,
      "weight": 800,
      "soft": 80,
      "opsz": 30
    },
    "number": {
      "font": "display",
      "size": 22,
      "line": 26,
      "weight": 700,
      "soft": 50,
      "opsz": 36,
      "features": "tnum"
    },
    "body": {
      "font": "ui",
      "size": 14,
      "line": 20,
      "weight": 500
    },
    "button": {
      "font": "ui",
      "size": 13,
      "line": 18,
      "weight": 600
    },
    "caption": {
      "font": "ui",
      "size": 12,
      "line": 16,
      "weight": 500
    },
    "overline": {
      "font": "ui",
      "size": 11,
      "line": 14,
      "weight": 700,
      "tracking": "0.09em",
      "transform": "uppercase"
    },
    "data": {
      "font": "mono",
      "size": 12,
      "line": 16,
      "weight": 500
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pill": 999,
    "cell": "0.14 * s",
    "cellFlat": "0.10 * s"
  },
  "depth": {
    "press": 3,
    "pressAction": 4,
    "elevation": {
      "z0-sheet": "0 3px 14px var(--pk-sheet-shadow)",
      "z1-tissue": "0 max(1px, .03s) min(.06s, 4px) var(--pk-contact)",
      "z2-card": "cast (min(.03s,2.4), min(.10s,8)) + ply (min(.06s,3.6), min(.12s,7.2)), blur min(.16s,12.8) in var(--pk-shadow) + ambient 0 (min(.02s,1.6)+.5) min(.05s,3) in var(--pk-contact)",
      "z3-sticker": "0 max(1px,.04u) min(.08u,5px) var(--pk-contact)",
      "ui-float": "0 1px 0 var(--pk-edge-d), 0 6px 14px -8px var(--pk-sh)",
      "ui-button": "inset 0 1px 0 var(--pk-face-hi), 0 1px 0 edge-d, 0 2px 0 ply, 0 3px 0 edge-d, 0 5px 5px -2px sh (pressed: translateY(3px), inset 0 1px 3px sh)"
    },
    "jitter": "from s >= 14 (100%): amp min(.03s, 2.4px), segment .17s, inward-only, endpoints pinned, seeded by (r, c, side)"
  },
  "motion": {
    "easing": {
      "pop": "cubic-bezier(.34,1.56,.64,1)",
      "peel": "cubic-bezier(.4,0,1,1)",
      "out": "cubic-bezier(.2,.8,.2,1)",
      "press": "cubic-bezier(.3,.7,.4,1)",
      "flight": "cubic-bezier(.45,0,.2,1)"
    },
    "duration": {
      "press": 90,
      "peel": 160,
      "pop": 140,
      "tug": 240,
      "panel": 240,
      "flight": 420,
      "enter": 480,
      "pulse": 900,
      "bob": 2400,
      "drawPerUnit": 12,
      "drawMax": 1200,
      "flutter": 220
    },
    "reducedMotion": "durations -> 0, loops off, draw-on -> final; shadows, plies, edges and jitter stay",
    "paint": {
      "flutter": "220ms: dy -0.18s\u21920, scale 1.06\u21921 (pop easing), rotate \u00b10.12rad damped swing (1-t)^2\u00b7cos(3\u03c0t), seeded direction, shadow 2\u00d7\u21921\u00d7, alpha .4\u21921",
      "peelAway": "160ms (peel easing): a seeded corner lifts, rotate 0\u2192\u00b10.5rad about the opposite corner, scale 1\u21921.06, shadow 1\u21921.8\u00d7, alpha 1\u21920"
    }
  },
  "themes": {
    "paper": {
      "label": "Paper",
      "scheme": "light",
      "table": "#e6dbc4",
      "sheet": "#f8f3e6",
      "grid": "rgba(78,64,44,.10)",
      "card-ui": "#fbf7ee",
      "card-ui-2": "#f3ecdc",
      "strip": "#e9dcc1",
      "edge": "#ddd0b6",
      "edge-d": "#c9b893",
      "ink": "#2b2620",
      "ink-2": "#5a5145",
      "ink-3": "#6e6457",
      "sel": "#2f5bb3",
      "accent": "#f5c02c",
      "accent-d": "#b38712",
      "tape": "rgba(245,192,44,.55)",
      "card": "#2f3b5e",
      "card-under": "#4f5d88",
      "cut": "#8c9bc4",
      "cut-tl": "#b3c0e2",
      "shadow": "rgba(84,58,22,.30)",
      "contact": "rgba(84,58,22,.38)",
      "sheet-shadow": "rgba(92,66,28,.22)",
      "sh": "rgba(84,58,22,.30)",
      "thread": "#b02e22",
      "hole": "#bfae8c",
      "hole-shadow": "rgba(84,58,22,.45)",
      "sticker": "#fffaf0",
      "sticker-edge": "#d6c8aa",
      "stack-1": "#f2d9a6",
      "stack-2": "#e9b673",
      "stack-3": "#e3a066",
      "stack-4": "#dc9258",
      "stack-edge": "#9a6a33",
      "dot-1": "#4fa092",
      "dot-2": "#3f9384",
      "dot-3": "#62ad9f",
      "fibre-ink": "rgba(90,62,24,1)",
      "fibre-alpha": 1,
      "vignette": 0.1,
      "fibre-strength": 0.16,
      "grain": 160,
      "vignette-rgb": "70,45,15",
      "grid-pressed": "rgba(255,252,242,.35)",
      "face-hi": "rgba(255,255,255,.6)",
      "ply": "#e3d6bb",
      "accent-ply": "#d9a421",
      "hole-deep": "#8f7c58",
      "wall-fibre": 0.22
    },
    "night-paper": {
      "label": "Night Paper",
      "scheme": "dark",
      "table": "#10172d",
      "sheet": "#1c2648",
      "grid": "rgba(170,190,240,.08)",
      "card-ui": "#212c52",
      "card-ui-2": "#1a2445",
      "strip": "#2b3868",
      "edge": "#33406e",
      "edge-d": "#0d1430",
      "ink": "#f3ecdc",
      "ink-2": "#c9c0ad",
      "ink-3": "#a59d8c",
      "sel": "#8db4ff",
      "accent": "#f5c02c",
      "accent-d": "#a77c0c",
      "tape": "rgba(245,192,44,.40)",
      "card": "#dccaa2",
      "card-under": "#a8956d",
      "cut": "#fff4d8",
      "cut-tl": "#fffaf0",
      "shadow": "rgba(2,5,16,.55)",
      "contact": "rgba(2,5,16,.60)",
      "sheet-shadow": "rgba(0,0,0,.45)",
      "sh": "rgba(2,5,16,.6)",
      "thread": "#ff8a66",
      "hole": "#0b1124",
      "hole-shadow": "rgba(0,0,0,.6)",
      "sticker": "#fff6e6",
      "sticker-edge": "#c9b993",
      "stack-1": "#4a4766",
      "stack-2": "#7a5a52",
      "stack-3": "#93583a",
      "stack-4": "#8a4f33",
      "stack-edge": "#c99a6a",
      "dot-1": "#4aa89c",
      "dot-2": "#3f9a8f",
      "dot-3": "#56b5a8",
      "fibre-ink": "rgba(255,246,220,1)",
      "fibre-alpha": 0.9,
      "vignette": 0.16,
      "fibre-strength": 0.14,
      "grain": 200,
      "vignette-rgb": "0,4,18",
      "grid-pressed": "rgba(0,0,0,.22)",
      "face-hi": "rgba(255,255,255,.12)",
      "ply": "#18214a",
      "accent-ply": "#c99a14",
      "hole-deep": "#070b1c",
      "wall-fibre": 0.18
    }
  },
  "contrast": {
    "rules": {
      "text": 4.5,
      "nonText": 3.0,
      "pairs": [
        "ink/card-ui",
        "ink-3/card-ui",
        "ink-3/sheet",
        "card/sheet",
        "stack-edge/sheet",
        "thread/sheet",
        "sel/card-ui"
      ]
    },
    "paper": {
      "ink/card-ui": 14.02,
      "ink-3/card-ui": 5.42,
      "ink-3/sheet": 5.23,
      "card/sheet": 9.93,
      "stack-edge/sheet": 4.23,
      "thread/sheet": 5.81,
      "sel/card-ui": 6.01
    },
    "night-paper": {
      "ink/card-ui": 11.54,
      "ink-3/card-ui": 5.04,
      "ink-3/sheet": 5.49,
      "card/sheet": 9.16,
      "stack-edge/sheet": 5.85,
      "thread/sheet": 6.39,
      "sel/card-ui": 6.53
    }
  },
  "mapping": {
    "how": "A project preset = base theme + role overrides (+ flat:true for non-paper presets). Keep role names; never add per-object colours to the kit. Re-run checkTheme() from src/paper-kit.ts on every preset.",
    "flat": "flat presets: fibre none, jitter 0, single ply, radius cellFlat, torn edges off, shadows kept",
    "example-destroy-the-duck": {
      "paper-light": {
        "base": "paper",
        "roles": {
          "card": "wall",
          "stack-1..3": "weight 2/5/10",
          "dot-*": "visited",
          "thread": "path",
          "accent": "duck/Go"
        }
      },
      "paper-dark": {
        "base": "night-paper"
      },
      "classic-light": {
        "base": "paper",
        "flat": true,
        "overrides": {
          "sheet": "#D3D3D3",
          "card": "#04042C",
          "dot-1": "#7C4DA2",
          "dot-2": "#7C4DA2",
          "dot-3": "#7C4DA2",
          "thread": "#c23a1e"
        }
      },
      "classic-dark": {
        "base": "night-paper",
        "flat": true,
        "overrides": {
          "table": "#141418",
          "sheet": "#24242a",
          "grid": "#34343c",
          "card": "#c9cbe3",
          "card-under": "#9a9cb4",
          "dot-1": "#3f9a7a",
          "dot-2": "#3f9a7a",
          "dot-3": "#3f9a7a",
          "thread": "#FF6347"
        }
      }
    }
  }
}