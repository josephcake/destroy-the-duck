{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": false,
		"isolatedModules": true,
		"types": ["vitest/globals", "vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
